# Bagdja Payment Service (no trailing slash)
NEXT_PUBLIC_PAYMENT_API_URL=http://localhost:3002
# Optional internal API key used by the pay web server for legacy/internal service calls.
PAYMENT_SERVICE_INTERNAL_API_KEY=your-internal-api-key
# Optional explicit payment service URL for server-side calls.
PAYMENT_API_URL=http://localhost:3002
# Bagdja Auth (server-side) untuk memvalidasi tautan kembali halaman /wallet/pin
AUTH_API_URL=http://localhost:4001
# Halaman login Bagdja (no trailing slash)
NEXT_PUBLIC_LOGIN_URL=http://localhost:4003
